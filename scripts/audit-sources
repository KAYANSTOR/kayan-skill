#!/usr/bin/env python3
"""Report provenance fields that need human review; never update files automatically."""
from __future__ import annotations

import argparse
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", dest="as_json")
    args = parser.parse_args()
    path = ROOT / "registry" / "SOURCES_MANIFEST.json"
    payload = json.loads(path.read_text(encoding="utf-8"))
    missing = []
    for source in payload.get("sources", []):
        fields = ["commit_or_tag", "license"]
        absent = [field for field in fields if not source.get(field)]
        if absent:
            missing.append({"repository": source.get("repository"), "missing": absent})
    result = {"source_count": len(payload.get("sources", [])), "needs_review": missing}
    if args.as_json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print(f"Audited {result['source_count']} source records")
        if missing:
            print("Human review needed for:")
            for item in missing:
                print(f"- {item['repository']}: {', '.join(item['missing'])}")
        else:
            print("All provenance fields are populated")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
