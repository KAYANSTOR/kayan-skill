#!/usr/bin/env python3
"""Show a review-only update plan; upstream content is never overwritten automatically."""
from __future__ import annotations

import argparse
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="show the review-only plan")
    parser.add_argument("--apply", action="store_true", help="refuse automatic replacement and explain the safe workflow")
    args = parser.parse_args()
    manifest = json.loads((ROOT / "registry" / "SOURCES_MANIFEST.json").read_text(encoding="utf-8"))
    if args.apply:
        print("Automatic replacement is disabled to protect Kayan Soft local changes.")
        print("Review the upstream diff, update one skill at a time, run validate-skills, then commit explicitly.")
        return 2
    print(f"Review-only update plan for {len(manifest.get('sources', []))} sources:")
    for source in manifest.get("sources", []):
        print(f"- {source['repository']}: {source.get('status', 'needs-review')}")
    print("No network request or file replacement was performed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
